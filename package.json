{
  "name": "digi-classroom",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:analyze": "ANALYZE=true next dev",
    "build": "next build",
    "build:no-lint": "next build --no-lint",
    "build:analyze": "ANALYZE=true next build",
    "start": "next start",
    "lint": "next lint",
    "analyze": "ANALYZE=true next build",
    "migrate:menu": "node -r ts-node/register src/lib/db/menu-migrate.ts up",
    "migrate:menu:down": "node -r ts-node/register src/lib/db/menu-migrate.ts down",
    "migrate:menu:status": "node -r ts-node/register src/lib/db/menu-migrate.ts status",
    "setup:dictionary": "node -r ts-node/register scripts/setup-dictionary.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "jest src/__tests__/end-to-end-pipeline.test.ts",
    "test:integration": "jest src/__tests__/ai-tutor-integration.test.ts",
    "test:comprehensive": "node scripts/run-comprehensive-tests.js",
    "test:validate": "npm run test:comprehensive && echo '✅ All validation tests passed!'",
    "db:clean": "node scripts/clean-book-database.js",
    "db:clean:quick": "node scripts/quick-clean.js",
    "db:clean:force": "node scripts/clean-book-database.js --force",
    "db:reset": "npm run db:clean && echo '🚀 Database cleaned - ready for fresh upload!'",
    "fresh-upload": "npm run db:clean:quick && echo '🚀 Ready for fresh textbook upload!'",
    "grant-trial": "node -r ts-node/register scripts/grant-trial-access.ts",
    "db:setup": "node -r ts-node/register scripts/setup-base-schema.ts",
    "migrate:teacher": "node -r ts-node/register scripts/migrate-teacher-system.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.22.0",
    "@heroicons/react": "^2.2.0",
    "@langchain/textsplitters": "^0.1.0",
    "@qdrant/js-client-rest": "^1.7.0",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/react-query": "^5.80.7",
    "@trpc/client": "^11.4.2",
    "@trpc/next": "^11.4.2",
    "@trpc/react-query": "^11.4.2",
    "@trpc/server": "^11.4.2",
    "@types/uuid": "^10.0.0",
    "@xenova/transformers": "^2.17.2",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.1",
    "eventsource": "^4.0.0",
    "framer-motion": "^11.0.0",
    "googleapis": "^144.0.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.1",
    "katex": "^0.16.22",
    "lucide-react": "^0.517.0",
    "mysql2": "^3.14.1",
    "next": "15.3.4",
    "next-themes": "^0.4.6",
    "node-fetch": "^3.3.2",
    "openai": "^4.104.0",
    "pdf.js-extract": "^0.2.1",
    "react": "^19.0.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.0.0",
    "react-dropzone": "^14.3.8",
    "react-markdown": "^10.1.0",
    "recharts": "^2.15.3",
    "redis": "^5.6.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "superjson": "^2.2.2",
    "svix": "^1.69.0",
    "tailwind-merge": "^3.3.1",
    "uuid": "^11.1.0",
    "zod": "^3.25.67",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@babel/preset-typescript": "^7.27.1",
    "@eslint/eslintrc": "^3",
    "@next/bundle-analyzer": "^15.4.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/redis": "^4.0.10",
    "autoprefixer": "^10.4.21",
    "babel-jest": "^29.7.0",
    "eslint": "^9",
    "eslint-config-next": "15.3.4",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-html-reporters": "^3.1.7",
    "jest-junit": "^16.0.0",
    "postcss": "^8.5.6",
    "prisma": "^6.10.1",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
