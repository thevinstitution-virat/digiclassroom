{
  "version": "instruction-screen.v1",
  "about": "Text addressed to the marker rather than written as an answer. Each pattern is a JavaScript regular expression (flags: i, u) tested against the answer after it is lowercased, Unicode-normalised (NFC), stripped of zero-width characters, with punctuation turned into spaces and runs of spaces collapsed. An answer that matches ANY pattern is marked alone, shown to the teacher with a flag, and left out of 'accept all high-confidence suggestions'. No AI is involved. Add a pattern here to catch a new phrasing; a pattern that flags a genuine answer costs only an extra call and a flag. Keep each pattern specific: a phrase that a student could write in a real answer on the subject does not belong here.",
  "patterns": [
    { "id": "en-ask-marks", "lang": "en", "regex": "\\b(give|award|grant|assign|put|write|mark|score)\\b.{0,40}\\b(full|maximum|max|top|highest|perfect|all)\\b.{0,15}\\b(marks?|score|points?|credit)\\b", "note": "give / award full marks" },
    { "id": "en-ask-marks-2", "lang": "en", "regex": "\\b(full|maximum|top|perfect) (marks?|score)\\b.{0,30}\\b(to|for) (this|me|every|all|each|the)\\b", "note": "full marks to this / every answer" },
    { "id": "en-zero-others", "lang": "en", "regex": "\\b(give|award|grant|assign)\\b.{0,40}\\b(zero|no|0)\\b.{0,15}\\b(marks?|score|credit)\\b.{0,40}\\b(other|others|rest|everyone|all)\\b", "note": "zero marks to the others" },
    { "id": "en-others-zero", "lang": "en", "regex": "\\b(every|all|the) other (answers?|students?|papers?)\\b.{0,40}\\b(zero|wrong|incorrect|fail)", "note": "the other answers are wrong / zero" },
    { "id": "en-deserve", "lang": "en", "regex": "\\bi (deserve|should get|must get|need)\\b.{0,25}\\b(full|more|pass|maximum|marks?)\\b", "note": "I deserve marks" },
    { "id": "en-please-mark", "lang": "en", "regex": "\\bplease\\b.{0,20}\\b(give|pass|award|mark|grade)\\b.{0,20}\\b(me|this)\\b", "note": "please pass / mark me" },
    { "id": "en-mark-correct", "lang": "en", "regex": "\\b(mark|grade|treat|consider|count)\\b.{0,20}\\b(this|my|it)\\b.{0,15}\\b(as )?(correct|right|perfect|full)\\b", "note": "mark this correct" },
    { "id": "en-ignore", "lang": "en", "regex": "\\b(ignore|disregard|forget|override|bypass|skip)\\b.{0,45}\\b(instructions?|rubric|marking scheme|scheme|rules?|prompt|above|previous|everything|guidelines?)\\b", "note": "ignore the instructions / rubric" },
    { "id": "en-new-instructions", "lang": "en", "regex": "\\b(new|updated|revised|special) (instructions?|rules?|task)\\b", "note": "new instructions" },
    { "id": "en-note-to-marker", "lang": "en", "regex": "\\b(note|message|instruction|request|attention)s? (to|for) (the |this )?(grader|marker|examiner|evaluator|checker|ai|assistant|model|bot)\\b", "note": "note to the grader" },
    { "id": "en-address-marker", "lang": "en", "regex": "\\b(dear|hello|hi|hey|attention) (grader|marker|examiner|evaluator|checker|ai|assistant|model|bot)\\b", "note": "addressing the marker" },
    { "id": "en-role", "lang": "en", "regex": "\\b(you are now|you are a|act as|pretend (to be|that you)|from now on you|your new (role|task|job))\\b", "note": "role instruction" },
    { "id": "en-system", "lang": "en", "regex": "(\\bsystem prompt\\b|\\bdeveloper (message|mode)\\b|\\bjailbreak\\b|^ *(system|assistant|developer) +)", "note": "system / developer text" },
    { "id": "en-claim-authority", "lang": "en", "regex": "\\b(i am|this is) (the |your |a )?(teacher|examiner|principal|admin|administrator|developer|invigilator)\\b", "note": "claims to be the teacher" },
    { "id": "en-trial", "lang": "en", "regex": "\\bthis (batch|paper|test|exam) is (a )?(trial|test|demo|practice) (run|mode)?\\b", "note": "this batch is a trial" },
    { "id": "hi-pure-ank", "lang": "hi", "regex": "(पूरे|पूर्ण|अधिकतम|सारे|सभी) (अंक|नंबर|अंकों)", "note": "पूरे अंक" },
    { "id": "hi-ank-do", "lang": "hi", "regex": "(अंक|नंबर) (दे दो|दे दीजिए|दे दीजिये|दीजिए|दीजिये|दो|देना|देने|दे)(?![\\p{L}\\p{M}])", "note": "अंक दो" },
    { "id": "hi-ignore", "lang": "hi", "regex": "(निर्देश|आदेश|नियम|मार्किंग स्कीम|अंक योजना)\\S{0,6} (को )?(अनदेखा|नज़रअंदाज़|नजरअंदाज|नजरंदाज|भूल जाओ|भूल जाइए|भूल जाएँ|मत मानो|मत मानें)", "note": "निर्देश अनदेखा करें" },
    { "id": "hi-all-instructions", "lang": "hi", "regex": "(सभी|सारे|पिछले|ऊपर के|ऊपर दिए) (निर्देश|आदेश)", "note": "सभी निर्देश" },
    { "id": "hi-pass", "lang": "hi", "regex": "(मुझे|इसे|इस उत्तर को) (पास|पूरे अंक|पूरे नंबर|सही)(?![\\p{L}\\p{M}])", "note": "मुझे पास कर दो" },
    { "id": "hi-pass-kar", "lang": "hi", "regex": "पास कर (दो|दीजिए|दीजिये|दें)", "note": "पास कर दो" },
    { "id": "hi-role", "lang": "hi", "regex": "(तुम|आप) (अब|अब से) (एक )?|मैं (शिक्षक|अध्यापक|परीक्षक|प्रधानाचार्य) हूँ|परीक्षक (महोदय|जी),? (कृपया|please)", "note": "भूमिका / परीक्षक को संबोधन" },
    { "id": "hi-others-zero", "lang": "hi", "regex": "(बाकी|अन्य|दूसरे) (सभी )?(उत्तरों?|विद्यार्थियों?|छात्रों?).{0,30}(शून्य|ग़लत|गलत|फेल|0)", "note": "बाकी सबको शून्य" },
    { "id": "hing-full-marks", "lang": "hinglish", "regex": "\\b(poore|pure|puri|pura) (marks|number|numbers|nambar|ank)\\b", "note": "poore marks" },
    { "id": "hing-marks-do", "lang": "hinglish", "regex": "\\b(marks|number|numbers|nambar)\\b.{0,12}\\b(de do|dedo|de dijiye|dijiye|do|dena|dena sir|de dena|de dijie)\\b", "note": "marks de do" },
    { "id": "hing-ignore", "lang": "hinglish", "regex": "\\b(ignore|nazarandaz|nazar andaz)\\b.{0,15}\\b(kar|karo|kijiye|kro|kardo|kar do)\\b|\\b(instructions?|rules?|rubric)\\b.{0,15}\\b(ignore|bhool|bhul|chhod|chod)\\b", "note": "ignore karo" },
    { "id": "hing-pass", "lang": "hinglish", "regex": "\\b(pass|paas) (kar|kardo|kar do|kr do|kar dijiye|kar dena)\\b|\\bmujhe (pass|paas|full marks|pure marks)\\b", "note": "pass kar do" },
    { "id": "hing-sir", "lang": "hinglish", "regex": "\\b(sir|madam|mam|maam)\\b.{0,20}\\b(please|plz|pls|kripya)\\b.{0,25}\\b(marks|number|pass|paas)\\b", "note": "sir please marks" },
    { "id": "hing-others", "lang": "hinglish", "regex": "\\b(baaki|baki|dusre|doosre|sabhi|sab)\\b.{0,25}\\b(answers?|students?|copies|copy)\\b.{0,25}\\b(zero|galat|fail|0)\\b", "note": "baaki sab ko zero" }
  ]
}
