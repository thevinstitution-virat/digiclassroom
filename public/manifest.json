{
  "name": "VG Kosh - Smart Learning Platform",
  "short_name": "VG Kosh",
  "description": "Comprehensive offline-first learning platform designed for Indian students with advanced productivity tools",
  "start_url": "/dashboard/user/productivity",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#4f46e5",
  "orientation": "portrait-primary",
  "scope": "/",
  "lang": "en-IN",
  "categories": ["education", "productivity", "utilities"],
  "icons": [
    {
      "src": "/favicon.ico",
      "sizes": "16x16 32x32",
      "type": "image/x-icon"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshot-mobile.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "VG Kosh Mobile Interface"
    },
    {
      "src": "/screenshot-desktop.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "VG Kosh Desktop Interface"
    }
  ],
  "shortcuts": [
    {
      "name": "CurricuTimer",
      "short_name": "Timer",
      "description": "Start adaptive study session",
      "url": "/dashboard/user/productivity?tool=curricutimer",
      "icons": [
        {
          "src": "/favicon.ico",
          "sizes": "32x32"
        }
      ]
    },
    {
      "name": "FlashBharat",
      "short_name": "Flashcards",
      "description": "Practice with flashcards",
      "url": "/dashboard/user/productivity?tool=flashbharat",
      "icons": [
        {
          "src": "/favicon.ico",
          "sizes": "32x32"
        }
      ]
    },
    {
      "name": "Dictionary",
      "short_name": "Shabdakosh",
      "description": "English-Hindi dictionary",
      "url": "/dashboard/user/dictionary",
      "icons": [
        {
          "src": "/favicon.ico",
          "sizes": "32x32"
        }
      ]
    },
    {
      "name": "Offline Mode",
      "short_name": "Offline",
      "description": "Access offline features",
      "url": "/dashboard/user/productivity?tool=offlineorbit",
      "icons": [
        {
          "src": "/favicon.ico",
          "sizes": "32x32"
        }
      ]
    }
  ],
  "related_applications": [],
  "prefer_related_applications": false,
  "edge_side_panel": {
    "preferred_width": 400
  },
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "protocol_handlers": [
    {
      "protocol": "web+vgkosh",
      "url": "/dashboard/user/productivity?action=%s"
    }
  ],
  "file_handlers": [
    {
      "action": "/dashboard/user/productivity",
      "accept": {
        "application/json": [".json"],
        "text/plain": [".txt"]
      }
    }
  ],
  "share_target": {
    "action": "/dashboard/user/productivity",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "file",
          "accept": ["image/*", "application/pdf", "text/plain"]
        }
      ]
    }
  },
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "handle_links": "preferred"
}
