# ============================================================================
# apps/web (frontend) — environment
# ============================================================================
# Copy to .env.local and fill in. The web app is UI-only; all backend/secret
# config now lives in apps/api/.env.example.

# Public URL of the API service (api.<domain>). Inlined into the browser bundle
# at build time; used by the tRPC client and the better-auth client.
NEXT_PUBLIC_API_URL="https://api.vinstitution.com"

# Public URL of this web app (app.<domain>). Used for absolute self-links.
NEXT_PUBLIC_APP_URL="https://app.vinstitution.com"

# Optional feature flag mirrored to the client.
NEXT_PUBLIC_FEDERATION_ENABLED="false"
