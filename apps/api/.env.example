# ============================================================================
# DigiClassroom Pro â€” Environment Configuration
# ============================================================================
# Copy this file to .env.local and fill in your actual values:
#   cp .env.example .env.local
#
# IMPORTANT: Never commit .env.local â€” it is gitignored for security.
# ============================================================================


# ============================================================================
# AUTHENTICATION â€” Better Auth
# ============================================================================
BETTER_AUTH_SECRET="change-me-to-a-random-64-char-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Federated Identity (Phase 4 — Vidyaverse as OIDC Provider).
# When FEDERATION_ENABLED=false the genericOAuth plugin is not registered,
# so existing email/password + Google + magic-link paths are unaffected.
FEDERATION_ENABLED="false"
NEXT_PUBLIC_FEDERATION_ENABLED="false"
VIDYAVERSE_ISSUER="http://localhost:3002"
VIDYAVERSE_CLIENT_ID=""
VIDYAVERSE_CLIENT_SECRET=""
# Optional super-admin bearer token, only used by scripts/reconcile-with-vidyaverse.ts.
VIDYAVERSE_ADMIN_TOKEN=""
# Shared taxonomy, served by Vidyaverse. The key is Vidyaverse's TAXONOMY_SERVICE_API_KEY.
# TAXONOMY_V2_ENABLED=true switches the super-admin taxonomy page to curriculum v2 (Book Buddy's
# taxonomy at /api/v1/curriculum); turn it on only after Vidyaverse serves it.
TAXONOMY_SERVICE_API_KEY=""
TAXONOMY_V2_ENABLED="false"


# ============================================================================
# DATABASE â€” PostgreSQL (Drizzle ORM)
# ============================================================================
# For local dev: use Docker (docker-compose.yml) on port 5433
# For production: use Neon, Supabase, or AWS RDS
DATABASE_URL="postgresql://digiclassroom_user:rootpassword123@localhost:5433/virat_gyankosh"


# ============================================================================
# REDIS CACHE
# ============================================================================
# For local dev: use Docker on port 6379
# For production: use Upstash, AWS ElastiCache, or equivalent
REDIS_URL=redis://:your_redis_password@localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password


# ============================================================================
# VECTOR DATABASE â€” Qdrant
# ============================================================================
# For local dev: use Docker on port 6333
# For production: use Qdrant Cloud (https://cloud.qdrant.io)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=ncert-books-enhanced
# QDRANT_API_KEY=your_qdrant_api_key_here  # Required for Qdrant Cloud


# ============================================================================
# AI SERVICES â€” OpenAI (https://platform.openai.com)
# ============================================================================
OPENAI_API_KEY=sk-your_openai_api_key_here


# LangChain Tracing (optional â€” for debugging RAG pipeline)
LANGCHAIN_API_KEY=your_langchain_api_key_here


# ============================================================================
# TRANSLATION â€” Microsoft Azure Cognitive Services
# ============================================================================
AZURE_TRANSLATOR_KEY=your_azure_translator_key_here
AZURE_TRANSLATOR_ENDPOINT=https://your-instance.cognitiveservices.azure.com
AZURE_TRANSLATOR_REGION=global


# ============================================================================
# GOOGLE DRIVE INTEGRATION (https://console.cloud.google.com)
# ============================================================================
GOOGLE_DRIVE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_DRIVE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3000/api/admin/materials/google-drive/callback
NEXT_PUBLIC_GOOGLE_API_KEY=your_google_api_key_here
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com


# ============================================================================
# EMAIL SERVICE â€” Resend (https://resend.com)
# ============================================================================
RESEND_API_KEY=re_your_resend_api_key_here
# From address. In Resend TEST mode (no verified domain) this MUST be
# onboarding@resend.dev and only delivers to your Resend account's own email.
# Verify a domain at resend.com/domains, then set e.g. noreply@yourdomain.com
EMAIL_FROM=DigiClassroom Pro <onboarding@resend.dev>


# ============================================================================
# APPLICATION
# ============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development


# ============================================================================
# PYTHON / PDF PROCESSING
# ============================================================================
PYTHON_PATH=python

# Smart Text Extraction Strategy
# Options: auto | text_only | ocr_only | mixed | force_pdf_extract_kit
TEXT_EXTRACTION_STRATEGY=auto

# PDF document extraction — PDF-Extract-Kit v1.0.0, GPU-accelerated (ACTIVE pipeline).
# Spawned by scripts/doc_extract_engine_processor.py. REQUIRES the CUDA-enabled
# Python 3.11 venv — system Python cannot import PDF-Extract-Kit (3.13 incompatibility).
DOC_EXTRACT_ENGINE_PYTHON_PATH=.venv-py311\Scripts\python.exe
DOC_EXTRACT_ENGINE_MODELS_PATH=./vendor/PDF-Extract-Kit/models


# ============================================================================
# RAG PIPELINE CONFIGURATION
# ============================================================================
USE_ENHANCED_RAG=true

# Relevance threshold (0.0â€“1.0). Higher = stricter filtering. 0.55 for dense-only.
RAG_RELEVANCE_THRESHOLD=0.55

# Hybrid Search (Dense + Sparse / BM25)
ENABLE_HYBRID_SEARCH=false

# Multi-Level Chunking (disabled â€” loses page numbers)
ENABLE_MULTI_LEVEL_CHUNKING=false

# A/B Testing: text-embedding-3-large vs text-embedding-3-small
ENABLE_EMBEDDING_EXPERIMENT=false

# Query Decomposition for complex multi-part questions
ENABLE_QUERY_DECOMPOSITION=true
QUERY_DECOMPOSITION_THRESHOLD=15
MAX_SUB_QUERIES=5

# Cross-Encoder Re-ranking (disabled â€” tensor dimension bug)
ENABLE_RERANKING=false
RERANKING_INITIAL_TOPK=20
RERANKING_FINAL_TOPK=5
RERANKING_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# GPT-4 Chapter Validation
ENABLE_CHAPTER_VALIDATION=true

# GPT-4 Vision Visual Element Detection (expensive â€” uses caching)
ENABLE_VISUAL_DETECTION=true
VISUAL_DETECTION_MODEL=gpt-4o


# ============================================================================
# FILE PROCESSING
# ============================================================================
MAX_FILE_SIZE_MB=10
MAX_AUDIO_SIZE_MB=25
TEMP_DIR=./tmp

# OCR
OCR_LANGUAGES=eng,spa,fra,deu
OCR_CONFIDENCE_THRESHOLD=30

# Speech-to-Text
STT_DEFAULT_LANGUAGE=en-US
STT_MAX_DURATION_SECONDS=300
STT_PROVIDER=openai


# ============================================================================
# FEATURE FLAGS
# ============================================================================
ENABLE_OCR=true
ENABLE_SPEECH_TO_TEXT=true
ENABLE_FILE_UPLOAD=true
ENABLE_REAL_TIME_TRANSCRIPTION=true

# Visual Processing
ENABLE_VISUAL_ANALYSIS=true
ENABLE_AI_VISUAL_ANALYSIS=true
ENABLE_INTERACTIVE_DETECTION=true


# ============================================================================
# RATE LIMITING
# ============================================================================
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_FILE_UPLOADS_PER_HOUR=20


# ============================================================================
# SECURITY
# ============================================================================
# IMPORTANT: Generate strong random values for production!
# Use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=generate_a_strong_random_secret_here
ENCRYPTION_KEY=generate_a_strong_random_key_here


# ============================================================================
# MONITORING & LOGGING
# ============================================================================
LOG_LEVEL=info
ENABLE_ANALYTICS=true


# ============================================================================
# DOCKER / PRODUCTION OVERRIDES
# ============================================================================
MYSQL_ROOT_PASSWORD=your_mysql_root_password
QDRANT_API_KEY=

# Other Services
ANTHROPIC_API_KEY=
ACME_EMAIL=admin@digiclassroom.com
GRAFANA_PASSWORD=your_grafana_password_here


# ============================================================================
# ML / OCR RUNTIME (Windows OpenMP workaround)
# ============================================================================
KMP_DUPLICATE_LIB_OK=TRUE
OMP_NUM_THREADS=1
HF_HOME=./.cache/huggingface
TORCH_HOME=./.cache/torch
PADDLEOCR_HOME=./.cache/paddleocr


# ============================================================================
# SARVAGYA MICROSERVICE (BullMQ Queue Processing)
# ============================================================================
# The internal URL of the Sarvagya FastAPI microservice
SARVAGYA_INTERNAL_URL=http://localhost:5005
# Secure token for authorizing internal service-to-service communication
SARVAGYA_SERVICE_TOKEN=your_secure_service_token_here


# ============================================================================
# SANCHIKA FEATURE FLAGS
# ============================================================================
# Phase 1 (Production Ready)
FEATURE_FOLDER_ORGANIZATION=false
FEATURE_NOTE_EXPORT=false
FEATURE_NOTE_TEMPLATES=false
FEATURE_AUTO_FLASHCARDS=true

# Phase 2 (Gradual Rollout)
FEATURE_AI_AUTO_TAGGING=false
FEATURE_AI_BATCH_ANALYSIS=true
FEATURE_SEMANTIC_SEARCH=false
FEATURE_SPACED_REPETITION=false
FEATURE_SIMPLE_SHARING=false
FEATURE_STUDY_SESSION=false

# OpenRouter Architecture
OPENROUTER_API_KEY="sk-or-v1-..."

# ============================================================================
# RAZORPAY
# ============================================================================
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_...

RESEND_API_KEY=re_...
RESEND_FROM_EMAIL="DigiClassroomPro <notifications@yourdomain.in>"
NEXT_PUBLIC_APP_URL=https://yourdomain.in


# ============================================================================
# FRONTEND / BACKEND SPLIT (monorepo: apps/web + apps/api)
# ============================================================================
# This API is served from api.<domain>; the web app from app.<domain>.
# BETTER_AUTH_URL above should point at THIS api host in production, e.g.:
#   BETTER_AUTH_URL="https://api.vinstitution.com"
# Web origin (for CORS + user-facing email links built server-side):
WEB_ORIGIN="https://app.vinstitution.com"
NEXT_PUBLIC_APP_URL="https://app.vinstitution.com"
# Comma-separated origins allowed to call this API with credentials:
CORS_ALLOWED_ORIGINS="https://app.vinstitution.com,http://localhost:3001"
# Parent domain so the session cookie is shared across app.<domain>/api.<domain>:
COOKIE_DOMAIN=".vinstitution.com"

# ============================================================================
# HANDWRITTEN ASSIGNMENTS (lib/hw)
# ============================================================================
# Default for institutions with no hw_tenant_quota row. Keep false: switch the
# feature on per institution (hw.admin.setQuota).
HW_FEATURE_DEFAULT_ENABLED=false
# Which AI service runs the reader and grader: gemini (Google direct) or openrouter.
# Both support the Batch API at half price. With openrouter, use model ids like
# google/gemini-3.5-flash-lite, and the cost OpenRouter reports is recorded as-is.
HW_AI_PROVIDER=gemini
# Google Gemini API (HW_AI_PROVIDER=gemini).
# Use a PAID-tier key: free-tier content is used to improve Google's products.
GEMINI_API_KEY=
# HW_AI_PROVIDER=openrouter uses the OPENROUTER_API_KEY defined above (shared with the
# AI tutor). Check the account's data-retention settings.
# ── Provider route of each step ───────────────────────────────────────────────
# Each step runs on HW_AI_PROVIDER unless its own route is set: HW_READ_PROVIDER (tier 1),
# HW_ESCALATE_PROVIDER (tier 2), HW_GRADE_PROVIDER (marking), HW_RUBRIC_PROVIDER (key-point drafts);
# answer keys use HW_KEY_WRITER_PROVIDER and HW_KEY_VERIFIER_PROVIDER (below). Values: gemini | openai | openrouter.
# A model id must be one its provider knows: bare "gemini-3.6-flash" on gemini, bare "gpt-6-luna" on openai,
# "vendor/model" on openrouter. Left as it is above, EVERY step runs on Gemini direct (needs GEMINI_API_KEY) and
# answer keys do nothing until HW_KEY_*_MODEL are set; the key verifier defaults to openrouter.
#
# DIRECT ROUTES for the pilot (Gemini models on Google direct, gpt-6-luna on OpenAI direct). Leave commented
# until the keys are in the secret store; nothing here is set anywhere yet.
#   RECOMMENDED, ONE BILL (OpenAI direct): gpt-6-luna reads, re-reads AND marks (docs/hw-eval/luna-reading.md). Luna reads
#   with the reasoning effort in HW_THINKING_LEVEL, so LOW here; marking has its own (HW_GRADE_REASONING_EFFORT, below).
#   Needs only OPENAI_API_KEY for reading, re-reading and marking:
#     HW_AI_PROVIDER=openai
#     HW_READ_MODEL=gpt-6-luna
#     HW_ESCALATE_MODEL=gpt-6-luna
#     HW_THINKING_LEVEL=LOW
#     HW_RUBRIC_MODEL=gpt-6-luna      (key-point drafts: a teacher reviews every one; luna was NOT measured on this step)
#   Answer keys keep their own routes (HW_KEY_WRITER_PROVIDER / HW_KEY_VERIFIER_PROVIDER, below): they are not on luna.
#   Gemini direct, PAID tier only (free-tier content is used to improve Google's products). Batch API supported,
#   images included. The Gemini alternative for reads and escalation:
#     HW_READ_PROVIDER=gemini
#     HW_ESCALATE_PROVIDER=gemini
#     GEMINI_API_KEY=<paid-tier key>
#     HW_READ_MODEL=gemini-3.5-flash-lite
#     HW_ESCALATE_MODEL=gemini-3.6-flash
#   OpenAI direct (OPENAI_API_KEY, defined above, is the same key the tutor uses). ACCURACY-FIRST marking = profile M1-strict
#   (docs/hw-eval/accuracy-first.md): gpt-6-luna, low reasoning, STRICT verdicts, one answer per call, instruction guard.
#   Do NOT use luna with the plain grade.v1 prompt: it let wrong facts through (detection 67-74% against 94%).
#   Strict marking sends one answer per call by itself (HW_GRADE_BATCH_SIZE is ignored while it is on):
#     HW_GRADE_PROVIDER=openai
#     HW_GRADE_MODEL=gpt-6-luna
#     HW_GRADE_REASONING_EFFORT=low
#     HW_STRICT_MARKING_ENABLED=true
#     HW_INSTRUCTION_GUARD_ENABLED=true   (needs migration 020 applied first)
#     HW_OPENAI_EXPLICIT_CACHE_ENABLED=true
#   Both flags make every group "configuration changed": AI marking stays off for a group until its evaluation runs under the
#   same setting are imported (npm run hw:eval:gates). HW_PARTIAL_CREDIT_RULE stays zero until the teachers decide.
#   Answer keys, profile K0 (writer on Gemini direct, verifier on OpenAI direct; different families):
#     HW_KEY_WRITER_PROVIDER=gemini
#     HW_KEY_WRITER_MODEL=gemini-3.6-flash
#     HW_KEY_VERIFIER_PROVIDER=openai
#     HW_KEY_VERIFIER_MODEL=gpt-5.4-mini
#   Prices for the models above, per 1M tokens, so cost is recorded: docs/hw-eval/price-table.json (the bare ids are
#   in it). Set HW_PRICE_TABLE_JSON to its contents without the "_comment" line.
#   Not routable today: one reader model serves every language, so "gpt-6-luna for English only" (R-luna) and
#   "Sarvam for Hindi only" (E-sarvam) exist as eval profiles only.
# Model IDs (confirmed on ai.google.dev/gemini-api/docs/models, Oct 2026).
# Tier 1 reader, tier 2 escalation, marking, key-point drafting.
HW_READ_MODEL=gemini-3.5-flash-lite
HW_ESCALATE_MODEL=gemini-3.6-flash
HW_GRADE_MODEL=gemini-3.5-flash-lite
HW_RUBRIC_MODEL=gemini-3.5-flash-lite
# MINIMAL works on 3.5 Flash-Lite and 3.6 Flash; 3.8 Flash needs LOW or higher.
HW_THINKING_LEVEL=MINIMAL
# Per-image resolution sent to the reader: LOW (~280 tokens) | MEDIUM | HIGH.
HW_READ_MEDIA_RESOLUTION=LOW
# Batch API: half price, results within 24h (usually much sooner).
HW_BATCH_ENABLED=true
HW_BATCH_MAX_BYTES=15728640
HW_BATCH_POLL_SECONDS=60
# Cost savings that cannot change an answer, a mark or a key (docs/hw-eval/cost-phase1.md).
# Each is off unless set. The shared-key, code-marking and dedupe flags need migration 019 applied first.
# Homework through the batch API with a ready-by time, and a visible fallback to the standard path.
# HW_HOMEWORK_BATCH_ENABLED=false
# HW_HOMEWORK_BATCH_DEADLINE_HOURS=24
# HW_HOMEWORK_URGENT_HOURS=3
# Textbook keys for public questions (textbook exercise, board paper) shared across tenants.
# HW_SHARED_KEYS_ENABLED=false
# One-mark answers equal to an accepted answer are marked in code.
# HW_CODE_MARKING_ENABLED=false
# Identical answers (same question, key version, normalised transcript) are marked once.
# HW_DEDUPE_MARKING_ENABLED=false
# Instruction guard: an answer addressed to the marker ("give me full marks", "ignore the scheme", in English, Hindi or
# Hinglish; phrase list in lib/hw/grader/instruction-phrases.json) is marked alone, flagged to the teacher and kept out of
# "accept all"; a point whose quote is not in that answer's own text lowers the answer's confidence.
# HW_INSTRUCTION_GUARD_ENABLED=false
# With the guard on, the teacher can tap "Not an instruction" on a flagged answer; the flags and the taps are recorded per
# pattern (needs migration 020, docs/hw-eval/migration-020-runbook.md) so the screen's false-positive rate can be measured.
# Strict marking (grade-strict.v2; not used by the production marker yet): what an answer with the right idea and ONE wrong detail
# earns. zero (the default) | half (half the point's marks, rounded down to a half mark) | full. The teachers decide this.
# HW_PARTIAL_CREDIT_RULE=zero
# A different rule for some subjects, as JSON (names matched case-insensitively): {"science":"half","hindi":"full"}
# HW_PARTIAL_CREDIT_BY_SUBJECT=
# GPT-5.6+ models: explicit prompt caching, so nothing is written to a cache that is never read.
# HW_OPENAI_EXPLICIT_CACHE_ENABLED=false
# Re-read with the tier 2 model when confidence is below this, or more words
# than this are unreadable.
HW_READ_ESCALATE_BELOW=0.7
HW_UNCLEAR_ESCALATE_ABOVE=3
# Answers per marking call, and how long to wait for more of a class's answers.
HW_GRADE_BATCH_SIZE=10
HW_GRADE_DEBOUNCE_SECONDS=120
# "Accept all high-confidence" uses suggestions at or above this.
HW_HIGH_CONFIDENCE=0.85
# Upload limits.
HW_RENDER_MAX_WIDTH=1000
HW_INK_MAX_BYTES=524288
HW_RENDER_MAX_BYTES=1048576
HW_JOB_STALE_MINUTES=10
# USD per 1M tokens, from ai.google.dev/gemini-api/docs/pricing (paid tier,
# Oct 2026). Check before 1 Jan 2027: 3.6 Flash prices double on that date.
HW_PRICE_TABLE_JSON={"inr_per_usd":84,"models":{"gemini-3.5-flash-lite":{"input":0.30,"cached":0.03,"output":2.50,"batch_input":0.15,"batch_output":1.25},"gemini-3.6-flash":{"input":0.75,"cached":0.075,"output":3.75,"batch_input":0.375,"batch_output":1.875}}}
# Bearer secret for POST /api/cron/hw-jobs (at least 32 characters). Unset = refused.
HW_CRON_SECRET=
# Phase 2 reader; unused in Phase 1.
SARVAM_API_KEY=

# ── Virat Evaluator (docs/hw-eval/stage1-design.md) ──────────────────────────
# Answer keys. The verifier must be another model family than the writer.
HW_KEY_WRITER_MODEL=
# gemini | openrouter; default: HW_AI_PROVIDER
HW_KEY_WRITER_PROVIDER=
HW_KEY_VERIFIER_MODEL=
HW_KEY_VERIFIER_PROVIDER=openrouter
# No default on purpose: calibrate with scripts/hw-key-calibrate.ts. Unset = keys refuse to run.
HW_KEY_R_MIN=
HW_KEY_EXERCISE_THETA=0.35
HW_KEY_TOP_K=30
HW_KEY_MAX_PASSAGES=6
HW_KEY_EMBED_MODEL=text-embedding-3-large
# content_item ids whose printed-page mapping a person has checked (comma-separated).
HW_KEY_PAGES_VERIFIED=
# Read-only Gyankosh index (QDRANT_URL, QDRANT_API_KEY, QDRANT_COLLECTION_NAME) and
# TRIO_CONTENT_DATABASE_URL are shared with the tutor.
# Evaluator tools (/evaluate, super-admin Evaluation page). Off unless true.
HW_EVAL_TOOLS_ENABLED=false
# Local folder with datasets/ and key-cache/ (development only); unset = R2 under hw-assignments/evals/.
HW_EVAL_LOCAL_ROOT=
# Datasets open for writing-pad copy tasks (comma-separated name@vN).
HW_EVAL_COPY_DATASETS=
# Shadow mode: this share of live answers (0-1) is also read/marked by a candidate config,
# after production, into hw_eval_shadow_result only (never shown, never used). Counts against
# the AI quota. 0 = off. Report: npm run hw:eval:live -w apps/api
HW_SHADOW_RATE=0
# e.g. {"reader":{"model":"google/gemini-3.6-flash"},"grader":{"model":"google/gemini-3.6-flash"}}
HW_SHADOW_CONFIG_JSON=

# Self-practice for independent learners (docs/hw-eval/self-practice.md; needs migration 031). Off unless true.
# A learner with no institution may start ONE free trial: TRIAL_DAYS long and limited to TRIAL_BUDGET_PAISE of AI cost
# (reading and marking; 1000 paise = Rs 10). A step does not start unless STEP_RESERVE_PAISE is still unspent.
# PLATFORM_BUDGET_PAISE is the practice space's monthly ceiling over all learners (read once, when the space is first created).
# Do not switch on before the strict-marking results have passed the gates, textbooks are ingested and answer keys can be built.
HW_SELF_PRACTICE_ENABLED=false
# Exam packages for learners (docs/hw-eval/exam-packages.md). Off by default.
HW_EXAMS_ENABLED=false
# LOCAL DEVELOPMENT ONLY: keep exam answer-page photos in this folder instead of R2 (ignored when NODE_ENV=production).
# HW_DEV_LOCAL_STORAGE_DIR=
HW_SELF_PRACTICE_TRIAL_DAYS=7
HW_SELF_PRACTICE_TRIAL_BUDGET_PAISE=1000
HW_SELF_PRACTICE_STEP_RESERVE_PAISE=5
HW_SELF_PRACTICE_PLATFORM_BUDGET_PAISE=200000
# The most questions one learner may start during the trial (each costs the platform an answer key).
HW_SELF_PRACTICE_MAX_ATTEMPTS=25
# InkBuddy opens the trial only when a textbook-key group is eligible for the running marking setup (marks are possible). false = open it before that
# (learners then get their handwriting read and no mark).
HW_SELF_PRACTICE_REQUIRE_ELIGIBLE_GROUP=true
# Answer keys on ONE provider (say OpenAI for writer and verifier): the key service normally requires the verifier to be another model FAMILY.
# true accepts one family (the two models must still differ). A weaker check, chosen by the owner; key quality on it is unmeasured.
# e.g. HW_KEY_WRITER_PROVIDER=openai HW_KEY_WRITER_MODEL=gpt-6-luna HW_KEY_VERIFIER_PROVIDER=openai HW_KEY_VERIFIER_MODEL=gpt-5.4-mini
HW_KEY_ALLOW_SAME_FAMILY=false
